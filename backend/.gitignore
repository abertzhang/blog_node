# ==========================================
# Express backend (backend/) 忽略配置
# 根 .gitignore 已全局忽略 node_modules/.env/coverage 等，
# 这里补 backend 特有的运行时产物，保证本目录可独立 clone。
# ==========================================

# 依赖
node_modules/

# 构建产物（当前为纯 JS，无编译；预留给将来 TS 化）
/dist
/build
*.tsbuildinfo

# 环境变量与密钥
.env
.env.*
!.env.example

# 日志（morgan 访问日志等运行时生成）
logs/
*.log
npm-debug.log*

# 本地数据库数据卷（docker-compose.local.yml 的 ./data/postgres）
data/

# 测试
coverage/

# 编辑器 / OS
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
