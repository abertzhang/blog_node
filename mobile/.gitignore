# ==========================================
# React Native (mobile/) 忽略配置
# 根 .gitignore 已全局忽略 node_modules/.env/coverage 等，
# 这里补 RN 原生产物，保证本目录可独立 clone。
# ==========================================

# OSX
.DS_Store
.DS_Store?
._*

# Xcode (iOS)
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local
ios/build/
ios/Pods/

# Android (Gradle)
build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/

# CocoaPods / Ruby bundle
/vendor/bundle/
.bundle/

# node.js
node_modules/
npm-debug.log
yarn-error.log

# Bundle artifacts
*.jsbundle

# Metro 打包器
.metro-health-check*
.watchman-cookie

# Expo（若将来启用）
.expo/
.expo-shared/

# Testing
/coverage

# 环境变量与密钥
.env
.env.*
!.env.example

# 杂项
*.log
