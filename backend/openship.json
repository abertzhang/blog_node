{
  "$schema": "https://openship.io/openship.schema.json",
  "framework": "express",
  "packageManager": "pnpm",
  "rootDirectory": "backend",
  "installCommand": "pnpm install --frozen-lockfile --prod",
  "startCommand": "pnpm run start",
  "port": 3000,
  "runtime": "docker",
  "env": {
    "NODE_ENV": "production"
  }
}