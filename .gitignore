# ==========================================
# 依赖 /包管理器
# ==========================================
# pnpm 用符号链接，node_modules 必须全局忽略（不要用 !/web/node_modules 反向包含）
node_modules/
.pnpm-store/
.pnp
.pnp.*

# yarn berry 保留目录（pnpm 项目下一般用不到，留作兼容）
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ==========================================
# 构建产物
# ==========================================
# Next.js（根与子目录都要覆盖）
.next/
out/
/web/.next/
/web/out/
/backend/dist/
/backend/build/

# Turborepo 缓存与任务日志
.turbo/
.turbo-cache/

# 通用产物目录
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ==========================================
# 环境变量与密钥
# ==========================================
# 所有 .env 变体默认忽略，仅放行示例文件
.env
.env.*
!.env.example
!.env.*.example

# 证书与私钥
*.pem
*.key
*.p12
*.pfx

# ==========================================
# Openship
# ==========================================
# .openship/project.json 记录本地项目链接，与他人无关，不进仓库
.openship/

# npm 在项目内生成的临时缓存
.npm-cache/

# ==========================================
# 日志与运行时
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# 进程文件（以 dotfile 开头的 next dev / turbo 守护进程 pid）
*.pid
*.pid.lock

# ==========================================
# 数据库与上传文件
# ==========================================
*.sqlite
*.sqlite3
*.db
*.db-journal

# ==========================================
# 测试
# ==========================================
coverage/
.nyc_output/

# ==========================================
# 编辑器 / IDE
# ==========================================
# JetBrains（.idea/ + *.iml）
.idea/
*.iml
*.iws
*.ipr

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ==========================================
# 操作系统
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ==========================================
# WorkBuddy 本地状态
# ==========================================
# .workbuddy/ 存放本地记忆与会话数据，属于个人工作区，不应进代码仓库
.workbuddy/

# ==========================================
# 备份与临时文件
# ==========================================
*.bak
*.swp
*~
\#*\#
.\#*
/tmp/
/temp/